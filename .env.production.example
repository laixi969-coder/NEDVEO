PUBLIC_URL=https://nedveo.example.com
ADMIN_EMAIL=owner@example.com
# 首次初始化需要12位以上随机密码；已有账户不会被该变量重置。
ADMIN_PASSWORD=replace-with-a-long-random-password
# 留空禁止新注册；设置后允许持码注册独立工作空间。
INVITE_CODE=

# 与 .env.database 中 DB_APP_PASSWORD 一致；密码若含URL特殊字符须编码。
DATABASE_URL=postgresql://nedveo_app:replace-with-random-hex@db:5432/nedveo
