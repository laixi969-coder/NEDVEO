{
  "name": "nedveo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build && node scripts/build-site.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "build:vercel": "npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/queue": "^0.11.0",
    "cheerio": "^1.2.0",
    "docx": "^9.15.3",
    "express": "^5.1.0",
    "he": "^2.0.0",
    "jose": "^6.2.16",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "image-size": "^2.1.0",
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "minimatch": "^11.0.1"
  }
